rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 256;
      allow delete: if isOwner(userId);

      // Devices owned by user
      match /devices/{deviceId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(deviceId)
          && request.resource.data.userId == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 128;
        allow update: if isOwner(userId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);

        // Sensors
        match /sensors/{sensorId} {
          allow read: if isOwner(userId);
          allow write: if isOwner(userId) && isValidId(sensorId);
        }

        // Telemetry
        match /telemetry/{telemetryId} {
          allow read: if isOwner(userId);
          allow write: if isOwner(userId) && isValidId(telemetryId);
        }

        // Commands
        match /commands/{commandId} {
          allow read: if isOwner(userId);
          allow write: if isOwner(userId) && isValidId(commandId);
        }
      }

      // Alerts
      match /alerts/{alertId} {
        allow read, write: if isOwner(userId) && isValidId(alertId);
      }

      // Automations
      match /automations/{automationId} {
        allow read, write: if isOwner(userId) && isValidId(automationId);
      }

      // Notifications
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) && isValidId(notificationId);
      }

      // Cameras
      match /cameras/{cameraId} {
        allow read, write: if isOwner(userId) && isValidId(cameraId);
      }

      // AI Conversations
      match /aiConversations/{conversationId} {
        allow read, write: if isOwner(userId) && isValidId(conversationId);
      }
    }
  }
}
